{
  "name": "jarvis",
  "version": "0.1.3",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "mobile:android:init": "tauri android init --ci --skip-targets-install && python3 scripts/prepare-android.py",
    "mobile:ios:init": "tauri ios init --ci --skip-targets-install",
    "test": "vitest run",
    "release:desktop": "node scripts/desktop-release.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-http": "^2.6.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "lucide-react": "^1.39.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vgpu": "^0.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@webgpu/types": "^0.1.60",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
